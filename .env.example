# 클라이언트 공개 설정(실제 값은 .env.local 또는 배포 환경에 저장)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_API_BASE=https://your-api-domain.example
EXPO_PUBLIC_SITE_URL=https://your-web-domain.example

# 선택적 관측 도구
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 빌드·서버 전용 비밀값(EXPO_PUBLIC_ 접두사 금지)
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
